# From your MAL app registration (Profile Settings > API). Used both for this
# app's own OAuth2 + PKCE login flow (/auth/login, /auth/callback) and to
# authenticate MAL's public API endpoints (search, ranking, detail, season).
# The app's registered redirect URI must be set to
# http://localhost:3001/auth/callback (adjust the port if you changed it).
MAL_CLIENT_ID=

# Optional. Routes outbound stream-source lookups (reanime.to, AniList) through an HTTP
# proxy. Cloudflare challenges requests from datacentre IPs, so these calls can succeed
# locally and return 403 once deployed to Vercel — pointing this at a proxy with a
# residential/ISP IP is the only fix once the block is at the IP layer.
#
# Format: http://user:pass@host:port (credentials optional).
# Leave unset to fetch directly — the app works normally without it.
STREAM_PROXY_URL=
