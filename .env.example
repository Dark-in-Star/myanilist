# Base URL of the myanilist-server instance this app talks to.
MAL_API_BASE_URL=http://localhost:3000

# From your MAL app registration (Profile Settings > API) — the same client ID
# configured in myanilist-server's own .env. Used for this app's own OAuth2 + PKCE
# login flow (/auth/login, /auth/callback). The app's registered redirect URI must
# be set to http://localhost:3001/auth/callback (adjust the port if you changed it).
MAL_CLIENT_ID=
