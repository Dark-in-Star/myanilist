# Copy this file to keystore.properties (same directory) and fill in real values.
# keystore.properties is gitignored — never commit it or the .jks/.keystore file it points to.
# See the "Android App (TWA)" section of the root README.md for how to generate a keystore.

storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=myanilist
keyPassword=CHANGE_ME
